<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.system.mapper.BizReservationMapper">

    <resultMap id="BizReservationResult" type="BizReservation">
        <id property="reservationId" column="reservation_id"/>
        <result property="deviceId" column="device_id"/>
        <result property="userId" column="user_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="purpose" column="purpose"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectBizReservationVo">
        select reservation_id,
               device_id,
               user_id,
               start_time,
               end_time,
               purpose,
               status,
               remark,
               create_by,
               create_time,
               update_by,
               update_time
        from biz_reservation
    </sql>

    <select id="selectBizReservationByReservationId"
            parameterType="Long"
            resultMap="BizReservationResult">
        <include refid="selectBizReservationVo"/>
        where reservation_id = #{reservationId}
    </select>

    <select id="selectBizReservationList"
            parameterType="BizReservation"
            resultMap="BizReservationResult">
        <include refid="selectBizReservationVo"/>
        <where>
            <if test="deviceId != null">
                and device_id = #{deviceId}
            </if>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
            <if test="startTime != null">
                and start_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                and end_time &lt;= #{endTime}
            </if>
        </where>
        order by start_time desc
    </select>

    <insert id="insertBizReservation"
            parameterType="BizReservation"
            useGeneratedKeys="true"
            keyProperty="reservationId">
        insert into biz_reservation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">device_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="purpose != null">purpose,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deviceId != null">#{deviceId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="purpose != null">#{purpose},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateBizReservation" parameterType="BizReservation">
        update biz_reservation
        <trim prefix="SET" suffixOverrides=",">
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="purpose != null">purpose = #{purpose},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where reservation_id = #{reservationId}
    </update>


    <update id="approveBizReservation" parameterType="Long">
        update biz_reservation
        set status = '1'
        where reservation_id = #{reservationId}
          and status = '0'
    </update>

    <update id="rejectBizReservation" parameterType="Long">
        update biz_reservation
        set status = '3'
        where reservation_id = #{reservationId}
          and status = '0'
    </update>

    <select id="countReservationConflict"
            parameterType="BizReservation"
            resultType="int">
        select count(*)
        from biz_reservation
        where device_id = #{deviceId}
          and reservation_id != ifnull(#{reservationId}, 0)
          and status in ('0', '1')
          and start_time &lt; #{endTime}
          and end_time &gt; #{startTime}
    </select>

    <delete id="deleteBizReservationByReservationId"
            parameterType="Long">
        delete from biz_reservation
        where reservation_id = #{reservationId}
    </delete>

    <delete id="deleteBizReservationByReservationIds"
            parameterType="Long">
        delete from biz_reservation
        where reservation_id in
        <foreach item="reservationId"
                 collection="array"
                 open="("
                 separator=","
                 close=")">
            #{reservationId}
        </foreach>
    </delete>

</mapper>
